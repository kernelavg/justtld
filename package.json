{
  "name": "justtld",
  "version": "1.0.0",
  "private": true,
  "description": "JustTLD — decentralized registry of user-owned TLD zones",
  "workspaces": [
    "contracts",
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "chain": "npm run node -w @justtld/contracts",
    "deploy": "npm run deploy:localhost -w @justtld/contracts",
    "deploy:fresh": "npm run deploy:fresh -w @justtld/contracts",
    "deploy:sepolia": "npm run deploy:sepolia -w @justtld/contracts",
    "deploy:mainnet": "npm run deploy:mainnet -w @justtld/contracts",
    "verify:sepolia": "node scripts/verify-explorer.mjs sepolia",
    "verify:mainnet": "node scripts/verify-explorer.mjs mainnet",
    "db:setup": "bash scripts/setup-db.sh",
    "db:start": "bash scripts/db.sh start",
    "db:stop": "bash scripts/db.sh stop",
    "db:restart": "bash scripts/db.sh restart",
    "db:status": "bash scripts/db.sh status",
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "db:backup": "bash scripts/backup-db.sh",
    "db:restore": "bash scripts/restore-db.sh",
    "indexer": "npm run start -w @justtld/indexer",
    "indexer:once": "npm run once -w @justtld/indexer",
    "indexer:resync": "npm run resync -w @justtld/indexer",
    "dev": "npm run dev -w @justtld/web",
    "build": "npm run build -w @justtld/web",
    "start": "npm run start -w @justtld/web",
    "start:all": "node scripts/start-all.mjs",
    "stop:all": "node scripts/stop-all.mjs",
    "net:localhost": "node scripts/switch-network.mjs localhost",
    "net:sepolia": "node scripts/switch-network.mjs sepolia",
    "net:mainnet": "node scripts/switch-network.mjs mainnet",
    "net:status": "node scripts/switch-network.mjs status",
    "test": "npm run test:contracts && npm run test:shared && npm run test:integration && npm run test:ui",
    "test:contracts": "npm run test -w @justtld/contracts",
    "test:shared": "vitest run --config packages/shared/vitest.config.ts",
    "test:integration": "vitest run --config packages/indexer/vitest.config.ts",
    "test:ui": "vitest run --config apps/web/vitest.config.ts",
    "verify:e2e": "tsx scripts/verify-e2e.ts",
    "test:static-dapp": "node scripts/test-static-dapp.mjs",
    "lint": "eslint . --ext .js,.mjs,.ts,.tsx --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p contracts/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "typecheck:web": "tsc -p apps/web/tsconfig.json --noEmit",
    "clean": "rm -rf node_modules apps/web/.next packages/*/dist",
    "test:walletconnect": "node scripts/test-walletconnect.mjs",
    "test:resolver": "node scripts/test-resolver.mjs",
    "setup:domain": "node scripts/setup-domain.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "dotenv": "^16.4.7",
    "eslint": "^8.57.1",
    "playwright": "^1.65.1",
    "prettier": "^3.4.2",
    "prettier-plugin-solidity": "^1.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
