# ─────────────────────────────────────────────────────────────
# JustTLD — пример конфигурации. Файл .env создаётся автоматически
# командой `npm run start:all` (или скопируйте вручную: cp .env.example .env)
# Приватные ключи и seed-фразы здесь НЕ хранятся и не требуются.
# ─────────────────────────────────────────────────────────────

# ── Blockchain (локальная EVM-сеть Hardhat) ──
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
# Адрес контракта и ABI читаются из deployments/localhost.json (создаёт `npm run deploy`)

# ── Indexer ──
INDEXER_CONFIRMATIONS=1
INDEXER_POLL_INTERVAL_MS=1000
INDEXER_START_BLOCK=
INDEXER_BATCH_SIZE=2000

# ── PostgreSQL ──
DATABASE_URL=postgresql://justtld:justtld@127.0.0.1:5432/justtld
PGDATA=./data/pgdata
PGPORT=5432
PGHOST=127.0.0.1

# ── Web / API ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_CHAIN_NAME="JustTLD Local Devnet"
PORT=3000
# Секрет для httpOnly-сессии админа. `npm run start:all` генерирует случайный.
SESSION_SECRET=dev-only-change-me-justtld-session-secret-32b

# ── Админ ──
# Адрес, которому разрешена админ-панель (должен совпадать с owner контракта).
# По умолчанию — деплоер (первый аккаунт Hardhat).
ADMIN_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# ── Dev Wallet (ТОЛЬКО для локальной разработки) ──
# Кошелёк-подписант на публично известных тестовых ключах Hardhat.
# В production-сборке обязательно ENABLE_DEV_WALLET=false.
ENABLE_DEV_WALLET=true
NEXT_PUBLIC_ENABLE_DEV_WALLET=true

# ── Обозреватель блоков ──
# Пусто = встроенный explorer (/tx/<hash>). Либо шаблон, например:
# EXPLORER_TX_URL_TEMPLATE=https://sepolia.etherscan.io/tx/{hash}
EXPLORER_TX_URL_TEMPLATE=

# ── Rate limiting (запросов в минуту) ──
RATE_LIMIT_READ=240
RATE_LIMIT_WRITE=30
RATE_LIMIT_AUTH=10
RATE_LIMIT_ADMIN=20

# ── Контракт: настраиваемые списки ──
# Дополнительные зарезервированные зоны и слова чёрного списка задаются
# через админ-панель (/admin) или on-chain вызовы; здесь — только для seed-скрипта.
SEED_EXTRA_BLACKLIST=scam,phishing,malware

# ─────────────────────────────────────────────────────────────
# Публичная сеть (Sepolia / Mainnet). Локальный режим ничего из этого не требует.
# ─────────────────────────────────────────────────────────────
# Какая сеть используется приложением и indexer'ом:
#   DEPLOYMENT_NETWORK=localhost | sepolia | mainnet
# Файл деплоя выбирается автоматически: deployments/<network>.json (или по CHAIN_ID).
DEPLOYMENT_NETWORK=localhost

# RPC публичной сети (можно публичный бесплатный или Alchemy/Infura)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
MAINNET_RPC_URL=

# Ключ деплоера. ТОЛЬКО через .env, никогда в git.
# Для тестнета — отдельный burner-кошелёк, на котором нет ничего кроме газа.
DEPLOYER_PRIVATE_KEY=

# Ключ Etherscan API v2 (для `npm run verify:sepolia`) — https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# Сколько подтверждений ждать indexer'у (для публичной сети 3–5)
# INDEXER_CONFIRMATIONS=3
